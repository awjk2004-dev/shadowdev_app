<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/streak_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SHADOWDEV // STREAK"
        android:textColor="#00F0FF"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/streak_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="🔥 0 يوم"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/system_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="النظام مستيقظ"
        android:textColor="#9AA6B2"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/day_saturday"
            style="@style/StreakWidgetDay"
            android:contentDescription="السبت" />

        <TextView
            android:id="@+id/day_sunday"
            style="@style/StreakWidgetDay"
            android:contentDescription="الأحد" />

        <TextView
            android:id="@+id/day_monday"
            style="@style/StreakWidgetDay"
            android:contentDescription="الاثنين" />

        <TextView
            android:id="@+id/day_tuesday"
            style="@style/StreakWidgetDay"
            android:contentDescription="الثلاثاء" />

        <TextView
            android:id="@+id/day_wednesday"
            style="@style/StreakWidgetDay"
            android:contentDescription="الأربعاء" />

        <TextView
            android:id="@+id/day_thursday"
            style="@style/StreakWidgetDay"
            android:contentDescription="الخميس" />

        <TextView
            android:id="@+id/day_friday"
            style="@style/StreakWidgetDay"
            android:contentDescription="الجمعة" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_refresh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_day_default"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:text="↻ تحديث"
        android:textColor="#00F0FF"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
